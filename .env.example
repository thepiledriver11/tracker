# Copy to .env.local for local dev, and set these in the Railway service too.

# From the Railway Postgres plugin
DATABASE_URL="postgresql://user:pass@localhost:5432/training?schema=public"

# bcrypt hash of your PIN. Generate with:  npm run -s seed:pin -- 1234   (see scripts/hash-pin.ts)
APP_PIN_HASH=""

# 32+ random bytes for signing the session cookie.  openssl rand -base64 48
SESSION_SECRET=""

# From BotFather
TELEGRAM_BOT_TOKEN=""

# Any random string; used to verify inbound Telegram webhook calls
TELEGRAM_WEBHOOK_SECRET=""

# Any random string; cron endpoints require  Authorization: Bearer <this>
CRON_SECRET=""

# The public origin of the deployed app, e.g. https://fitness-app.up.railway.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Keep the server on Sydney local time
TZ="Australia/Sydney"
